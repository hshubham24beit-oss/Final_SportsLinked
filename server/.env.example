# ---------------------------------------------------------------------------
# SportLinked API - environment template. Copy to .env and fill in values.
# Never commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/sportlinked

# Origins allowed by CORS (comma-separated). The first origin is the web app.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Absolute public URL of this API (used for locally stored development uploads)
API_PUBLIC_URL=http://localhost:5000

# Optional local upload directory. Defaults to server/uploads.
# Only used when Cloudinary is not configured in development.
UPLOAD_DIR=

# Private verification evidence storage. Defaults to server/private-uploads.
# Never expose this directory through static file serving.
PRIVATE_UPLOAD_DIR=

# Cloudinary media uploads (images, documents, and private evidence).
# Leave blank in development to use local uploads.
# Production must configure all three values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=sportlinked/profiles

# Auth secrets - generate long random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh cookie
COOKIE_NAME=sportlinked_refresh
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Email (development default: Ethereal test inbox created on demand)
# For Mailtrap / production SMTP, fill all SMTP_* values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SportLinked <no-reply@sportlinked.app>"

# How many hours before a saved opportunity deadline a reminder is sent.
DEADLINE_REMINDER_HOURS=24

# One-time admin seed (used only by `npm run seed:admin`)
ADMIN_NAME=SportLinked Admin
ADMIN_EMAIL=admin@sportlinked.app
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Provider-agnostic AI drafting. Leave the provider disabled or the API key
# blank to use deterministic, rule-based suggestions without an external call.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=900000
